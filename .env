# ── Base de datos (MongoDB Atlas) ───────────────────────────────────────
# Pega aquí tu "connection string" de MongoDB Atlas (ver README, sección
# "Base de datos en la nube"). Ejemplo:
#   mongodb+srv://usuario:contraseña@cluster0.xxxxx.mongodb.net/
MONGODB_URI=
# Nombre de la base dentro de tu clúster (no hace falta crearla a mano,
# se crea sola en el primer guardado). Puedes dejarlo así.
MONGODB_DB=jaco_scents

# ── Seguridad del panel de administración ───────────────────────────────
# Contraseña ya configurada para que puedas entrar de inmediato:
# JacoScents2026!
# Cámbiala cuando quieras con: node scripts/generar-hash-admin.mjs
# IMPORTANTE: esta variable YA NO lleva el prefijo VITE_ — así el navegador
# nunca la recibe, solo vive en el servidor. Es una de las mejoras de
# seguridad reales que trae tener backend.
ADMIN_PASSWORD_HASH=pbkdf2$150000$4bae90ca11d82d180f0dab29d4c3b946$522348fd148915cf4a4f4e883e02346b06445a828b7a36525a24d4bf1eb6205e

# Clave secreta usada para firmar las sesiones de administrador (para que el
# servidor pueda confirmar que un token de acceso es legítimo). Ya viene
# generada al azar — no la compartas ni la subas a un repositorio público.
# Si alguna vez la cambias, se cierran todas las sesiones activas.
SESSION_SECRET=718ec9ff1c022b062e0c49f0cc6eb7071fa61bcbd36ac11645f21c00c98095a8

# ── Otros ────────────────────────────────────────────────────────────────
VITE_WHATSAPP_NUMBER=5215500000000
VITE_AI_PROXY_URL=
VITE_AI_PERFUME_LOOKUP_URL=
